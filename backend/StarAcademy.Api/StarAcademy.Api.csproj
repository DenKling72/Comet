<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ============================================================================
       StarAcademy.Api — ASP.NET Core Web API (.NET 8, LTS)
       Пакеты:
        - Npgsql.EntityFrameworkCore.PostgreSQL : провайдер PostgreSQL для EF Core
        - Swashbuckle.AspNetCore                : Swagger UI (тестирование API в браузере)
       ============================================================================ -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>          <!-- включаем nullable-аннотации (string? и т.п.) -->
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization> <!-- меньше проблем с ICU в Docker -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>